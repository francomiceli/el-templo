# El Templo API - Production Environment (AWS)
# Copy to el-templo-api/.env.production and fill in values

# Server Configuration
PORT=3000
NODE_ENV=production

# Database (MySQL on same EC2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=eltemplo
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
DB_NAME=eltemplo

# Frontend URL (for CORS) - use Elastic IP
FRONTEND_URL=http://YOUR_ELASTIC_IP

# JWT Secret - GENERATE A NEW ONE!
# Run: openssl rand -base64 64
JWT_SECRET=GENERATE_WITH_openssl_rand_-base64_64

# Logging
LOG_LEVEL=info
