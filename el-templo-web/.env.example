# El Templo Web - Environment Variables
# Copy to .env and update values for your environment

# API Connection (populated by runtimeConfig)
# El build (prebuild scripts/fetch-web-data.mjs) lee sedes, marca, WhatsApp de ventas y blog de
# GET <NUXT_PUBLIC_API_URL>/web/site-data. Con una URL REMOTA (CI/CD) el build FALLA si la API no
# responde o el payload es invalido (nunca publica datos viejos). Sin esta variable, o con
# localhost caido, usa data/web-data.fixture.json: SOLO para desarrollo, nunca para publicar.
# En CI/CD el deploy corre `node scripts/verify-seo-output.mjs --require-api`, que rechaza un
# build generado desde el fixture. Rollout en 2 pasos: deploy/ROLLOUT-195.md
NUXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Sentry error monitoring
# NUXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Environment identifier (set by CI/CD)
# NUXT_PUBLIC_APP_ENVIRONMENT=staging

# Google Analytics 4
# En produccion sale del secret de GitHub WEB_GA4_ID (deploy.yml). Staging NO lo recibe.
# NUXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Meta Pixel
# En produccion sale del secret de GitHub WEB_META_PIXEL_ID (deploy.yml). Staging NO lo recibe.
# NUXT_PUBLIC_META_PIXEL_ID=123456789
