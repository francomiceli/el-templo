{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": true
  },
  "include": ["src/**/*", "../el-templo-api/src/db/schema/**/*"],
  "exclude": ["node_modules", "dist"]
}
