# El Templo Bot - Environment Variables
# Copy to .env and update values for your environment

# Database (same as el-templo-api — shared MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=eltemplo

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=a_random_string_you_choose
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# AI Provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxx
# OpenAI SDK request timeout in milliseconds. Phase 94 LAT-01.
# Default: 45000. Cross-phase invariant locks the default at 45000 — see DEBOUNCE_TTL_SECONDS below.
OPENAI_TIMEOUT_MS=45000
# Tool-handler localhost-call timeout in milliseconds. Phase 95 BOOK-01 + Phase 97 RGUARD-03.
# Default: 30000. The Cross-Phase Invariant (see DEBOUNCE_TTL_SECONDS below) locks this value at 30s.
EXECUTE_TOOL_TIMEOUT_MS=30000
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Server (webhook receiver)
PORT=3001
NODE_ENV=development

# El Templo API (localhost calls for actions)
API_BASE_URL=http://localhost:3000

# Bot-to-API authentication (must match el-templo-api BOT_API_KEY)
BOT_API_KEY=a_random_secret_for_bot_api_calls

# Debounce key TTL in Redis (seconds). Phase 93 ↔ 94 ↔ 97 Cross-Phase Invariant:
#   DEBOUNCE_TTL_SECONDS >= (OPENAI_TIMEOUT_MS/1000) * MAX_TOOL_ITERATIONS
#                         + (executeTool_timeout * MAX_TOOL_ITERATIONS)
#                         + safety_buffer
# Worst-case post-Phase-94+97: 45*5 + 30*5 + 20 = 395s → round up to 600s.
# Lower values re-introduce BUG-01 as a side effect of fixing BUG-02.
DEBOUNCE_TTL_SECONDS=600

# Trailing-debounce quiet window in milliseconds. Phase 100 DBNC-01.
# Replaces the legacy fixed DEBOUNCE_DELAY_MS=3000.
# Default: 7000. Bot waits this long after the LAST inbound before firing.
DEBOUNCE_QUIET_WINDOW_MS=7000

# Trailing-debounce absolute cap in milliseconds. Phase 100 DBNC-01.
# Default: 30000. Bot fires regardless of typing rate once cap is reached.
# MUST be << DEBOUNCE_TTL_SECONDS*1000 (current ratio ~20x; 30s << 600s).
DEBOUNCE_HARD_CAP_MS=30000

# Takeover acknowledgment Redis TTL in seconds. Phase 100 TAKE-02.
# Default: 3600 (1h). One reassurance message per phone per TTL window.
# If takeover lasts > TTL and the lead messages again, a second ack is
# acceptable (T-100-06 disposition: accept).
TAKEOVER_ACK_TTL_SECONDS=3600

# v5.3.3 Phase 99 (PRICE-02): threshold for PB1 price disclosure. Default 2
# means disclose on the 3rd price-objection-style inbound while in PB1.
# Bot-side only; DB plan prices are owned by subscription_plans.price_regular.
PB1_PRICE_INSISTENCE_THRESHOLD=2
