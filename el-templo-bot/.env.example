# El Templo Bot - Environment Variables
# Copy to .env and update values for your environment

# Database (same as el-templo-api — shared MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=eltemplo

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=a_random_string_you_choose
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# AI Provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Server (webhook receiver)
PORT=3001
NODE_ENV=development

# El Templo API (localhost calls for actions)
API_BASE_URL=http://localhost:3000
