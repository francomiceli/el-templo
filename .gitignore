# Root dependencies
node_modules/
pnpm-lock.yaml

# Per-workspace pnpm config — sólo local. Su único uso es minimumReleaseAge
# para installs interactivos del dev (no aplica en CI con --frozen-lockfile).
# Declararlo tracked rompe el layout de node_modules que `cap sync` espera.
pnpm-workspace.yaml

.planning/intel/

# AWS infrastructure variables (contains IPs, instance IDs)
deploy/.aws-vars

# CREDENTIALS files
deploy/.credentials

# Build artifacts
build/

# Local documentation (not tracked)
.docs/

# PDF proof of concept
poc-pdf/

# Video pipeline artifacts
el-templo-video-pipeline/
el-templo-tools/

# iOS signing credentials
tools/ios-signing/

# Firebase mobile config — injected at build time from GitHub secrets
# (mirrors the Android google-services.json pattern)
el-templo-app/src-capacitor/ios/App/App/GoogleService-Info.plist
el-templo-app/src-capacitor/android/app/google-services.json