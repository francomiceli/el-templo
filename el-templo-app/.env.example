# El Templo App - Environment Variables
# Copy to .env and update values for your environment

# API Connection
VITE_API_URL=http://localhost:3000/api

# App
VITE_APP_NAME=El Templo

# Optional: Sentry (added in Phase 19)
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Optional (dev only): artificial latency per request in ms, with 0.5x-1.5x jitter, to reproduce slow-network flicker (phase 203). Ignored in production builds.
# VITE_DEV_LATENCY_MS=800
