# El Templo API - Environment Variables
# Copy to .env.development or .env.production

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=eltemplo

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:9000

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Seed Script Passwords (only needed for database seeding)
SEED_ADMIN_PASSWORD=your_admin_password_here
SEED_DEFAULT_PASSWORD=your_default_password_here
