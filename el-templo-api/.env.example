# El Templo API - Environment Variables
# Copy to .env and update values for your environment

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=eltemplo

# Authentication
JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=30m

# CORS Origins (production)
FRONTEND_URL=https://app.eltemplo.org
ADMIN_URL=https://admin.eltemplo.org

# Base URL used to build the campaign tracking links embedded in marketing
# emails (open pixel / click redirect / unsubscribe — Phase 119; magic-link
# exchange — Phase 180). Defaults to https://api.eltemplo.org in code
# (el-templo-api/src/modules/campaigns/service.ts) when unset — correct in
# prod, INCORRECT in dev/staging (tracking links would point at prod). Set it
# explicitly in every non-prod environment.
PUBLIC_API_BASE_URL=http://localhost:3000

# Optional: Sentry (added in Phase 19)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Server
PORT=3000
NODE_ENV=development

# Cloudflare R2 (Video Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_api_token_access_key
R2_SECRET_ACCESS_KEY=your_r2_api_token_secret
R2_BUCKET_NAME=el-templo-videos
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Resend (Email notifications)
# REQUIRED IN PROD: without RESEND_API_KEY all email (transactional AND
# marketing campaigns) degrades silently — no delivery, no error. Set it in the
# prod secret store, never commit a real key (.env.example documents the var
# name only).
RESEND_API_KEY=re_xxxxxxxx
# Transactional sender (password reset/set, trial reminder, internal
# notifications). Must be a mailbox on a domain verified in Resend AND inside
# the API key's domain scope. Unset → falls back to CAMPAIGN_EMAIL_FROM (the
# current prod state: one verified subdomain for everything). Set it to a
# DIFFERENT verified subdomain (e.g. mail.eltemplo.org) once you want marketing
# spam complaints isolated from password emails. With neither set the legacy
# noreply@eltemplo.org is used, which is NOT verified in prod (Resend 403).
EMAIL_FROM=""  # e.g. "El Templo <noreply@mail.eltemplo.org>"
FRANCHISE_NOTIFICATION_EMAIL=ignaciobordon@eltemplo.org
GLADIUS_NOTIFICATION_EMAIL=ignaciobordon@eltemplo.org
ACADEMY_NOTIFICATION_EMAIL=ignaciobordon@eltemplo.org
APP_NOTIFICATION_EMAIL=ignaciobordon@eltemplo.org

# Campaign sender (marketing emails — Phase 119, D-17).
# Dedicated sending subdomain (send.eltemplo.org), kept separate from the
# transactional mail for deliverability. Falls back to the transactional
# noreply@ sender when unset, and campaign sending degrades silently without
# RESEND_API_KEY.
#
# PROD SETUP (D-17, human-only, no CLI/API path):
#   1. In the Resend dashboard add the sending subdomain send.eltemplo.org.
#   2. On eltemplo.org DNS create the records Resend lists: SPF TXT, DKIM
#      CNAME/TXT, Envelope-From TXT, and the bounce MX. These coexist with
#      Google Workspace because the subdomain carries its own SPF (DMARC:
#      strict DKIM / relaxed SPF aligns with Workspace).
#   3. Wait for Resend to report the domain "Verified", then set this var to
#      the verified subdomain sender (example below).
CAMPAIGN_EMAIL_FROM=""  # set once Resend domain verified, e.g. "El Templo <hola@send.eltemplo.org>"

# Anthropic (AI Agent for Franchise Management)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Firebase (Push Notifications)
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json
# DRY_RUN=true

# Seed Script Passwords (only needed for database seeding)
SEED_ADMIN_PASSWORD=your_admin_password_here
SEED_DEFAULT_PASSWORD=your_default_password_here

# Wellhub (ex Gympass) — integración de check-in y reservas.
# Sin WELLHUB_API_KEY + WELLHUB_WEBHOOK_SECRET la integración queda apagada
# (el webhook responde 503 y no se publica nada). WELLHUB_BASE_URL es opcional:
# default sandbox (https://apitesting.partners.gympass.com); en producción
# setear https://api.partners.gympass.com. El mapeo sede→gimnasio vive en
# branches.wellhub_gym_id (DB), no acá.
# WELLHUB_BASE_URL=https://apitesting.partners.gympass.com
WELLHUB_API_KEY=""
WELLHUB_WEBHOOK_SECRET=""
# API de confirmación de reservas: v2 (default, docs vigentes) o v1 (legacy).
# WELLHUB_BOOKING_API=v2
# Solo para scripts/wellhub-sandbox.ts (el server resuelve el gym por sede):
# WELLHUB_GYM_ID=546

# Sentinel de tenancy — modo inventario (fase 170, CON-05, D-08/D-04).
# El sentinel se instala siempre sobre el pool (src/plugins/database.ts) y en su
# corrida normal deja EN SILENCIO las violaciones sobre tablas de módulos que
# todavía no se migraron al patrón `tenantWhere`/`tenantValues` (hoy: todas).
# Con SENTINEL_INVENTORY=1 acumula TODAS esas violaciones sin tope de statements
# distintos y las devuelve agregadas por `report()` — es la forma de producir el
# inventario determinístico de excepciones corriendo la suite de tests.
# Es OPCIONAL y por eso va comentada: apagado no cambia ningún comportamiento
# (no altera el throw sobre módulos migrados, ni el log de prod, ni las queries).
# SENTINEL_INVENTORY=1

# Meta (fase 195) — sin estas variables CAPI y gasto quedan apagados (el job lo
# dice en el log y la API arranca igual). NUNCA cargarlas en staging: corre con
# datos reales clonados y mandaría conversiones reales a Meta.
# Token: de un usuario del sistema con acceso al pixel/dataset
# y a la cuenta publicitaria (permiso ads_read). Nunca se loguea.
# Fecha de activación (META_CAPI_START_AT): ISO obligatoria, solo se mandan eventos posteriores. No
# cargarla hasta que la nueva /privacidad esté en producción.
# Cuentas (META_AD_ACCOUNT_IDS): ids de cuenta publicitaria separados por coma (act_123 o 123).
META_ACCESS_TOKEN=""
META_PIXEL_ID=""
META_CAPI_START_AT=""
META_AD_ACCOUNT_IDS=""
# META_GRAPH_VERSION=v26.0
# META_CAPI_TEST_EVENT_CODE=

# Google (fase 195) — sin estas variables los jobs quedan apagados (el job lo
# dice en el log y la API arranca igual). GBP solo en producción, nunca en
# staging: escribe en las fichas públicas reales y staging comparte datos con prod.
# Search Console (job semanal, solo lectura): service account de GCP en base64
# (base64 -w0 key.json), agregada como usuario de la propiedad en Search Console.
GOOGLE_SC_SERVICE_ACCOUNT_BASE64=""
# GOOGLE_SC_SITE_URL=sc-domain:eltemplo.org
# Business Profile (job diario): off (default, no hace nada), dry-run (valida con
# validateOnly=true sin aplicar) o apply (aplica solo si cambió algo). El refresh
# token sale de scripts/gbp-authorize.ts; el cliente OAuth tiene que estar "In production".
GBP_SYNC_MODE="off"
GBP_OAUTH_CLIENT_ID=""
GBP_OAUTH_CLIENT_SECRET=""
GBP_REFRESH_TOKEN=""
